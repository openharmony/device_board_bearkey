import("//build/ohos.gni")

ohos_prebuilt_etc("ws73_cfg.ini") {
  source = "ws73_cfg.ini"
  part_name = "rockchip_products"
  install_images = [ "system" ]
  relative_install_dir = "../etc"
  install_enable = true
}

ohos_prebuilt_etc("ws73") {
  source = "ws73"
  part_name = "rockchip_products"
  install_images = [ "system" ]
  relative_install_dir = "../etc"
  install_enable = true
}

ohos_prebuilt_etc("sle_client_sample") {
  source = "sle_client_sample"
  part_name = "rockchip_products"
  install_images = [ "system" ]
  relative_install_dir = "../bin"
  install_enable = true
}

ohos_prebuilt_etc("sle_server_sample") {
  source = "sle_server_sample"
  part_name = "rockchip_products"
  install_images = [ "system" ]
  relative_install_dir = "../bin"
  install_enable = true
}

ohos_prebuilt_etc("plat_soc.ko") {
  source = "plat_soc.ko"
  part_name = "rockchip_products"
  install_images = [ "vendor" ]
  relative_install_dir = "."
  install_enable = true
}

ohos_prebuilt_etc("sle_soc.ko") {
  source = "sle_soc.ko"
  part_name = "rockchip_products"
  install_images = [ "vendor" ]
  relative_install_dir = "."
  install_enable = true
}

group("ws73e_driver") {
  deps = [
    ":ws73_cfg.ini",
    ":ws73",
    ":sle_client_sample",
    ":sle_server_sample",
    ":plat_soc.ko",
    ":sle_soc.ko",
  ]
}
