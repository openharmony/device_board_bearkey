import("//build/ohos.gni")
import("//vendor/$product_company/$product_name/product.gni")

ohos_shared_library("vendorGnssAdapter") {
    output_name = "vendorGnssAdapter"
    cflags = [ 
      "-w", 
      "-g", 
      "-O", 
      "-fPIC",
    ] 

    defines += [ 
        "__USER__",
    ]

    include_dirs = [
        "include",
        "//drivers/peripheral/location/gnss/hdi_service",
        "//base/location/location/interfaces/inner_api/include",
        "//utils/native/base/include",
        "//drivers/hdf_core/framework/include/utils",
        "//drivers/hdf_core/adapter/uhdf2/osal/include",
        "//drivers/hdf_core/framework/include/platform",
    ]

    sources = [
        "src/vendor_gnss_adapter.cpp",
        "src/uart_io_stream.cpp",
        "src/minmea.c",
    ]

    external_deps = [
        "c_utils:utils",
        "hdf_core:libhdf_host",
        "hdf_core:libhdf_utils",
        "hilog:libhilog",
        "drivers_interface_location_agnss:location_agnss_idl_headers",
    ]

    symlink_target_name = [ "vendorGnssAdapter.so" ]
    install_images = [ "system" ]
    part_name = "device_bq3588" 
    subsystem_name = "device_bq3588" 
    install_enable = true
    output_extension = "so"
}
