import("//build/ohos.gni")

ohos_shared_library("ril_quectel") {
  branch_protector_ret = "pac_ret"
  sources = [
    "src/at_call.c",
    "src/at_data.c",
    "src/at_modem.c",
    "src/at_network.c",
    "src/at_sim.c",
    "src/at_sms.c",
    "src/at_support.c",
    "src/vendor_adapter.c",
    "src/vendor_channel.c",
    "src/vendor_report.c",
    "src/vendor_util.c",
  ]
 include_dirs = [ "./include" ]
  defines = [
    "LOG_TAG = \"RilVendor\"",
    "LOG_DOMAIN = 0xD001F08",
  ]

  cflags_cc = []
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "ril_adapter:hril_innerkits",
  ]

  install_images = [ chipset_base_dir ]
  part_name = "device_bq3588"
  subsystem_name = "device_bq3588"
}
